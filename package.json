{
  "name": "@aftergraph/brand",
  "version": "1.1.0",
  "description": "Canonical Brand OS, visual assets, semantic symbols, and UI contracts for Aftergraph",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-icons.mjs && node scripts/generate-families.mjs && node scripts/generate-characters.mjs && node scripts/compose-characters.mjs && node scripts/generate-character-icons.mjs && node scripts/generate-character-sprites.mjs && node scripts/generate-character-review.mjs && node scripts/generate-character-rive.mjs",
    "export-assets": "node scripts/export-assets.mjs && node scripts/export-character-assets.mjs --out exports/characters",
    "validate": "node scripts/validate.mjs && node scripts/validate-character-source.mjs",
    "test": "node --test",
    "check": "npm run generate && npm run validate && npm test",
    "character:generate": "node scripts/compose-characters.mjs && node scripts/generate-character-icons.mjs && node scripts/generate-character-sprites.mjs",
    "character:bounds": "node characters/ci/verify-composition-bounds.mjs --report characters/generated/qa/composition-bounds.json",
    "character:visual:render": "node characters/ci/render-snapshots.mjs --config characters/ci/ci-checks.yml",
    "character:visual:check": "npm run character:visual:render && node characters/ci/compare-snapshots.mjs --config characters/ci/ci-checks.yml",
    "character:visual:update": "node characters/ci/render-snapshots.mjs --config characters/ci/ci-checks.yml --baseline",
    "audit:high": "npm audit --audit-level=high",
    "character:export": "node scripts/export-character-assets.mjs --out exports/characters",
    "character:qa": "npm run character:bounds && node characters/ci/verify-small-sizes.mjs --report characters/generated/qa/small-size.json && node characters/ci/verify-contexts.mjs --report characters/generated/qa/context-visibility.json && npm run character:visual:check",
    "character:review:generate": "node scripts/generate-character-review.mjs",
    "character:authoring:preflight": "node scripts/prepare-character-authoring-evidence.mjs --out characters/ci/evidence/authoring-preflight.json",
    "character:review:capture": "node characters/ci/capture-review.mjs",
    "character:rive:generate": "node scripts/generate-character-rive.mjs",
    "character:rive:verify": "node scripts/verify-character-rive.mjs",
    "character:rive:build": "node scripts/build-character-rive.mjs",
    "character:rive:qa": "node scripts/verify-character-rive-runtime.mjs",
    "character:candidate:verify": "node scripts/verify-character-production-readiness.mjs --mode candidate",
    "character:production:verify": "node scripts/verify-character-production-readiness.mjs --mode production",
    "character:review:bundle": "node scripts/prepare-character-review-bundle.mjs --out dist/character-review-bundle",
    "character:release:promote": "node scripts/promote-character-release.mjs"
  },
  "bin": {
    "assetgen": "./scripts/assetgen.mjs"
  },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./tokens": {
      "types": "./types.d.ts",
      "import": "./index.mjs"
    },
    "./tokens.json": "./tokens.json",
    "./manifest.json": "./manifest.json",
    "./tokens.css": "./tokens.css",
    "./css": "./tokens.css",
    "./react": {
      "types": "./types.d.ts",
      "import": "./react.mjs"
    },
    "./svg/*": "./svg/*",
    "./characters/*": "./characters/*",
    "./characters/manifest.json": "./characters/manifest.json",
    "./characters/release.json": "./characters/release.json",
    "./characters/roles.json": "./characters/roles.json",
    "./characters/states.json": "./characters/states.json",
    "./characters/accessibility.json": "./characters/accessibility.json",
    "./characters/contexts.json": "./characters/contexts.json",
    "./characters/themes.json": "./characters/themes.json",
    "./characters/contracts": {
      "types": "./characters/contracts/components.d.ts"
    },
    "./characters/source/*": "./characters/source/*",
    "./characters/generated/*": "./characters/generated/*",
    "./characters/motion/*": "./characters/motion/*",
    "./characters/accessibility": "./characters/accessibility.json",
    "./characters/contexts": "./characters/contexts.json",
    "./characters/themes": "./characters/themes.json",
    "./characters/release": "./characters/release.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aftergraph/brand.git"
  },
  "keywords": [
    "aftergraph",
    "design-system",
    "brand",
    "tokens",
    "governed-intelligence",
    "visual-language"
  ],
  "author": "Aftergraph Architecture Council",
  "license": "Apache-2.0",
  "files": [
    "index.mjs",
    "react.mjs",
    "types.d.ts",
    "tokens.css",
    "tokens.json",
    "manifest.json",
    "USAGE-RULES.md",
    "DESIGN-SYSTEM.md",
    "svg",
    "identity",
    "semantics",
    "social",
    "editorial",
    "product",
    "wallpaper",
    "characters",
    "schemas",
    "scripts",
    "registry.json",
    "BRAND-ARCHITECTURE.md",
    "NAMING-AND-LANGUAGE.md",
    "ACCESSIBILITY.md",
    "MOTION.md",
    "SCREENSHOT-STANDARD.md",
    "RESEARCH-VISUAL-STANDARD.md",
    "PRESS-AND-MEDIA.md",
    "!characters/motion/rive/build/*.log",
    "!characters/motion/rive/build/*.png",
    "!characters/motion/rive/build/*.data.json"
  ],
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.11.0",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  }
}
